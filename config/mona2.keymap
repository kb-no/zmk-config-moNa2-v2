#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt 4 ESC>;
            key-positions = <39 38>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W             &kp E         &kp R      &kp T                                                                     &kp Y                   &kp U  &kp I      &kp O    &lt_to_layer_0 6 P
&mt LEFT_SHIFT A  &kp S             &kp D         &kp F      &kp G                                             &trans                  &kp H                   &kp J  &kp K      &kp L    &mt RIGHT_SHIFT MINUS
&mt LEFT_GUI Z    &kp X             &kp C         &kp V      &kp B                   &kp ESCAPE                &kp CAPSLOCK            &kp N                   &kp M  &kp COMMA  &kp DOT  &kp RIGHT_GUI
&kp TAB           &kp LEFT_CONTROL  &kp LEFT_ALT  &bspc_del  &lt_to_layer_0 2 SPACE  &lt_to_layer_0 1 ENTER    &lt_to_layer_0 3 LANG1  &lt_to_layer_0 4 LANG2                             &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &trans                    &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS
&kp F5  &kp F6   &kp F7   &kp F8   &trans            &trans  &kp EQUAL     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ASTERISK
&trans  &trans   &trans   &trans   &trans  &trans    &trans  &trans                                                  &kp SLASH
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp SQT          &kp DOUBLE_QUOTES  &kp GRAVE      &kp CARET    &trans                    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE              &kp COLON
&kp EXCLAMATION  &kp QUESTION       &kp AT_SIGN    &kp HASH     &trans            &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH             &kp SEMICOLON
&kp DOLLAR       &kp PERCENT        &kp AMPERSAND  &kp INT_YEN  &trans  &trans    &trans  &trans  &kp RA(NUMBER_8)      &kp RA(NUMBER_9)       &kp NON_US_BACKSLASH  &kp UNDERSCORE
&trans           &trans             &trans         &trans       &trans  &trans    &trans  &trans                                                                     &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans                  &trans              &trans                   &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &kp RC(RG(LEFT_ARROW))  &kp RC(UP_ARROW)    &kp RC(RG(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp RA(RG(LEFT_ARROW))  &kp RC(DOWN_ARROW)  &kp RA(RG(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                                       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp K_MUTE         &kp C           &kp UP_ARROW    &trans            &trans
&trans  &trans  &trans  &trans  &trans            &trans  &kp C_VOLUME_UP    &kp LEFT_ARROW  &kp SPACE       &kp RIGHT_ARROW   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp C_VOLUME_DOWN  &kp LESS_THAN   &kp DOWN_ARROW  &kp GREATER_THAN  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                               &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
